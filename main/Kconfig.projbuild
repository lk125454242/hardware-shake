# put here your custom config value
# 注意：各 GPIO 不可重复。当前默认占用：OLED 8,9 | 电机 2,3,4 | 按钮 5,6,7,10
menu "Example Configuration"
config ESP_WIFI_SSID
    string "WiFi SSID"
    default "DESKTOP-F5CB7OD"
    help
	SSID (network name) for the example to connect to.

config ESP_WIFI_PASSWORD
    string "WiFi Password"
    default "629/dP27"
    help
	WiFi password (WPA or WPA2) for the example to use.

config OLED_I2C_SDA_GPIO
    int "OLED I2C SDA GPIO"
    default 8
    help
        GPIO for I2C SDA (SSD1306). 勿与其它引脚重复。

config OLED_I2C_SCL_GPIO
    int "OLED I2C SCL GPIO"
    default 9
    help
        GPIO for I2C SCL (SSD1306). 勿与其它引脚重复。

config OLED_I2C_ADDR
    hex "OLED I2C 地址"
    default 0x3C
    help
        SSD1306 I2C 从机地址，常见 0x3C 或 0x3D。

config TMC2209_STEP_GPIO
    int "TMC2209 STEP 引脚"
    default 2
    help
        步进脉冲输出 GPIO。勿与 OLED/其它按钮重复。

config TMC2209_DIR_GPIO
    int "TMC2209 DIR 引脚"
    default 3
    help
        方向控制 GPIO。勿与其它引脚重复。

config TMC2209_ENABLE_GPIO
    int "TMC2209 ENABLE 引脚"
    default 4
    help
        使能引脚，低电平使能。勿与其它引脚重复。

config BTN_SPEED_UP_GPIO
    int "按钮1 增加转速 GPIO"
    default 5
    help
        轻触开关，增加电机转速。勿与其它引脚重复。

config BTN_SPEED_DOWN_GPIO
    int "按钮2 减少转速 GPIO"
    default 6
    help
        轻触开关，减少电机转速。勿与其它引脚重复。

config BTN_MOTOR_START_GPIO
    int "按钮3 电机启动 GPIO"
    default 7
    help
        轻触开关，电机启动。勿与其它引脚重复。

config BTN_MOTOR_STOP_GPIO
    int "按钮4 电机停止 GPIO"
    default 10
    help
        轻触开关，电机停止。勿与其它引脚重复。

config MOTOR_STEPS_PER_REV
    int "步进电机每圈步数"
    default 200
    help
        1.8° 电机一般为 200 步/圈（整步）。
endmenu
